# AI Model API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Vector Database
VECTOR_DB_TYPE=chroma
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_API_KEY=your_vector_db_api_key_here

WEAVIATE_API_KEY=your_weaviate_api_key_here

# MCP Server Configuration
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_ROOT=./data

MCP_DATABASE_ENABLED=false
STAGING_DB_CONNECTION=postgresql://user:password@localhost:5432/db
PRODUCTION_DB_CONNECTION=postgresql://user:password@prod-host:5432/db

MCP_GITHUB_TOKEN=your_github_token_here
MCP_SLACK_TOKEN=your_slack_token_here
MCP_GOOGLE_DRIVE_CREDENTIALS=path/to/google/credentials.json

# Application Configuration
LOG_LEVEL=DEBUG
ENVIRONMENT=development
DEBUG=true

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_min_32_chars

# Monitoring
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Cost Tracking
MONTHLY_BUDGET_USD=100.00
COST_ALERT_THRESHOLD=0.8

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_MULTI_MODAL=false
