{
  "server": "database",
  "version": "1.0.0",
  "capabilities": [
    "connect",
    "execute_query",
    "execute_batch",
    "list_tables",
    "describe_table"
  ],
  "config": {
    "pool_size": 5,
    "max_overflow": 10,
    "pool_timeout": 30,
    "pool_recycle": 3600
  },
  "supported_databases": [
    "postgresql",
    "mysql",
    "sqlite",
    "oracle"
  ]
}
