{
  "server": "filesystem",
  "version": "1.0.0",
  "capabilities": [
    "read_file",
    "write_file",
    "list_directory",
    "create_directory",
    "delete_path",
    "search_files"
  ],
  "config": {
    "root_path": "./data",
    "allowed_paths": [],
    "read_only": false,
    "max_file_size": 10485760
  },
  "permissions": {
    "read": true,
    "write": true,
    "delete": true,
    "execute": false
  }
}
